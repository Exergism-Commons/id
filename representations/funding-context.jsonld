{
  "@context": {
    "ec": {"@id": "https://id.exergism.org/commons#", "@prefix": true},
    "ecg": {"@id": "https://id.exergism.org/governance#", "@prefix": true},
    "ecf": {"@id": "https://id.exergism.org/funding#", "@prefix": true},
    "xsd": {"@id": "http://www.w3.org/2001/XMLSchema#", "@prefix": true},
    "iri": "@id",
    "type": "@type",

    "id": "ec:stableId",
    "title": "ec:title",
    "status": "ec:status",
    "rationale": "ec:rationale",
    "operative": {"@id": "ec:operative", "@type": "xsd:boolean"},
    "provenance": "ec:provenance",
    "reviewDue": {"@id": "ec:reviewDue", "@type": "xsd:date"},
    "supersedes": {"@id": "ec:supersedes", "@type": "@id"},

    "Actor": "ec:Actor",
    "Person": "ec:Person",
    "Organization": "ec:Organization",

    "GovernanceRecord": "ecg:GovernanceRecord",
    "GovernanceDecision": "ecg:GovernanceDecision",
    "Vote": "ecg:Vote",
    "ConflictDisclosure": "ecg:ConflictDeclaration",
    "governanceVersion": "ecg:governanceVersion",
    "decisionDate": {"@id": "ecg:decisionDate", "@type": "xsd:date"},
    "approvalClass": {"@id": "ecg:decisionClass", "@type": "@vocab"},
    "ordinary": "ecg:OrdinaryApproval",
    "qualified": "ecg:QualifiedApproval",
    "emergency": "ecg:EmergencyAction",
    "conflictDisclosure": {"@id": "ecg:hasConflictDeclaration", "@type": "@id"},
    "interestedParty": {"@id": "ecg:interestedParty", "@type": "@id"},
    "hasVote": {"@id": "ecg:hasVote", "@type": "@id", "@container": "@set"},
    "voter": {"@id": "ecg:voter", "@type": "@id"},
    "voteValue": "ecg:voteValue",

    "FundingOpportunity": "ecf:FundingOpportunity",
    "FundingAcceptanceDecision": "ecf:FundingAcceptanceDecision",
    "CompensationDecision": "ecf:CompensationDecision",
    "EndowmentPrincipalWithdrawalDecision": "ecf:EndowmentPrincipalWithdrawalDecision",
    "DiversificationPlan": "ecf:DiversificationPlan",
    "InstitutionalFundingState": "ecf:InstitutionalFundingState",
    "FundingPhaseState": "ecf:FundingPhaseState",
    "BootstrapState": "ecf:BootstrapState",
    "NormalState": "ecf:NormalState",
    "FundingDependencyState": "ecf:FundingDependencyState",
    "DiversifiedState": "ecf:DiversifiedState",
    "ElevatedConcentrationState": "ecf:ElevatedConcentrationState",
    "StrategicDependencyState": "ecf:StrategicDependencyState",
    "Funder": "ecf:Funder",

    "funder": {"@id": "ecf:funder", "@type": "@id"},
    "opportunity": {"@id": "ecf:opportunity", "@type": "@id"},
    "amount": {"@id": "ecf:amount", "@type": "xsd:decimal"},
    "currency": "ecf:currency",
    "restricted": {"@id": "ecf:restricted", "@type": "xsd:boolean"},
    "fit": {"@id": "ecf:fit", "@type": "xsd:decimal"},
    "fundingValue": {"@id": "ecf:fundingValue", "@type": "xsd:decimal"},
    "capabilityValue": {"@id": "ecf:capabilityValue", "@type": "xsd:decimal"},
    "strategicOptionality": {"@id": "ecf:strategicOptionality", "@type": "xsd:decimal"},
    "autonomyValue": {"@id": "ecf:autonomyValue", "@type": "xsd:decimal"},
    "networkValue": {"@id": "ecf:networkValue", "@type": "xsd:decimal"},
    "recurrence": {"@id": "ecf:recurrence", "@type": "xsd:decimal"},
    "captureRisk": {"@id": "ecf:captureRisk", "@type": "xsd:decimal"},
    "adminCost": {"@id": "ecf:adminCost", "@type": "xsd:decimal"},
    "executionRisk": {"@id": "ecf:executionRisk", "@type": "xsd:decimal"},
    "rankEligible": {"@id": "ecf:rankEligible", "@type": "xsd:boolean"},
    "singleFunderConcentrationAfter": {"@id": "ecf:singleFunderConcentrationAfter", "@type": "xsd:decimal"},
    "governanceRightGranted": {"@id": "ecf:governanceRightGranted", "@type": "xsd:boolean"},
    "ecWideIpOwnershipGranted": {"@id": "ecf:ecWideIpOwnershipGranted", "@type": "xsd:boolean"},
    "exclusiveCoreInfrastructureRightGranted": {"@id": "ecf:exclusiveCoreInfrastructureRightGranted", "@type": "xsd:boolean"},
    "diversificationPlan": {"@id": "ecf:diversificationPlan", "@type": "@id"},
    "institutionalPhase": {"@id": "ecf:institutionalPhase", "@type": "@id"},
    "dependencyState": {"@id": "ecf:dependencyState", "@type": "@id"},
    "beneficiary": {"@id": "ecf:beneficiary", "@type": "@id"},
    "workBasis": "ecf:workBasis",
    "compensationAmount": {"@id": "ecf:compensationAmount", "@type": "xsd:decimal"},
    "principalWithdrawalAmount": {"@id": "ecf:principalWithdrawalAmount", "@type": "xsd:decimal"},
    "exceptionalCondition": {"@id": "ecf:exceptionalCondition", "@type": "xsd:boolean"},
    "endowmentPurpose": "ecf:endowmentPurpose"
  }
}
